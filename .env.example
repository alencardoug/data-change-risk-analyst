# Copy to .env and fill in. .env is git-ignored.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# cheap local runs: LLM_MODEL=gpt-4o-mini
# reasoning model: LLM_MODEL=o4-mini  (temperature is dropped automatically for o-series)
# to switch back to Claude: LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5,
#   and `uv add langchain-anthropic` + set ANTHROPIC_API_KEY

# --- Database (LangGraph checkpoints + analysis_record) ---
# local: matches docker-compose.yml
DATABASE_URL=postgresql://dcra:dcra@localhost:5432/dcra
# production (Neon, see DEPLOYMENT.md): append ?sslmode=require, e.g.
#   postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/dcra?sslmode=require

# --- LangSmith tracing (ADR-013: on by default; works with any provider) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=dcra

# --- Behaviour ---
DCRA_REVISION_LIMIT=2

# --- V1 increment (ADR-020): read downstream-usage evidence via a local MCP server ---
# off by default; set to 1 to route collect_usage through python -m dcra.mcp.server
DCRA_USAGE_VIA_MCP=0
