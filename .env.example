# Copy to .env and fill in. .env is git-ignored.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# --- Database (LangGraph checkpoints + analysis_record) ---
# matches docker-compose.yml
DATABASE_URL=postgresql://dcra:dcra@localhost:5432/dcra

# --- LangSmith tracing (ADR-013: on by default) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=dcra

# --- Behaviour ---
DCRA_REVISION_LIMIT=2
