# Copy to .env and fill in. .env is git-ignored.

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# cheap local runs: LLM_MODEL=gpt-4o-mini
# reasoning model: LLM_MODEL=o4-mini  (temperature is dropped automatically for o-series)
# to switch back to Claude: LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5,
#   and `uv add langchain-anthropic` + set ANTHROPIC_API_KEY

# --- Database (LangGraph checkpoints + analysis_record) ---
# matches docker-compose.yml
DATABASE_URL=postgresql://dcra:dcra@localhost:5432/dcra

# --- LangSmith tracing (ADR-013: on by default; works with any provider) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=dcra

# --- Behaviour ---
DCRA_REVISION_LIMIT=2
